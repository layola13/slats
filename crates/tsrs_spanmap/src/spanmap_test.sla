// spanmap_test.go:366
@test "original_to_virtual_duplicate_group"() {
    let m = new(&seeds2(
        segment(0u32, 5u32, 100u32, 105u32, Kind::verbatim(), Feature::all()),
        segment(10u32, 15u32, 100u32, 105u32, Kind::verbatim(), Feature::all()),
    ));
    let got = original_to_virtual_positions(&m, 102u32, Feature::all());
    if len(&got) != 2 { panic(1); };
    if got[0].position != 2u32 { panic(2); };
    if got[1].position != 12u32 { panic(3); };
}

// spanmap_test.go:514
@test "feature_participation_original_and_virtual"() {
    let m = new(&seeds2(
        segment(0u32, 5u32, 100u32, 105u32, Kind::verbatim(), Feature::hover()),
        segment(10u32, 15u32, 100u32, 105u32, Kind::verbatim(), Feature::rename()),
    ));
    let hovered = original_to_virtual_positions(&m, 102u32, Feature::hover());
    if len(&hovered) != 1 { panic(1); };
    if hovered[0].position != 2u32 { panic(2); };
    let renamed = original_to_virtual_positions(&m, 102u32, Feature::rename());
    if len(&renamed) != 1 { panic(3); };
    if renamed[0].position != 12u32 { panic(4); };
    let (_, f1) = virtual_to_original_span_for_feature(&m, tr(0u32, 5u32), Feature::rename());
    if !fidelity_eq(f1, Fidelity::None_) { panic(5); };
    let (_, f2) = virtual_to_original_span_for_feature(&m, tr(0u32, 5u32), Feature::hover());
    if !fidelity_eq(f2, Fidelity::Exact) { panic(6); };
}

// spanmap_test.go:559
@test "marshal_round_trip"() {
    let original = new(&seeds2(
        segment(3u32, 14u32, 60u32, 71u32, Kind::atom(), Feature::none()),
        segment(14u32, 24u32, 71u32, 81u32, Kind::verbatim(), Feature::none()),
    ));
    let encoded = marshal(&original);
    let data = match encoded {
        Ok(v) => { v }
        Err(e) => { panic(1); }
    };
    let decoded_result = unmarshal(&data);
    let decoded = match decoded_result {
        Ok(v) => { v }
        Err(e) => { panic(2); }
    };
    let (want_range, want_fidelity) = virtual_to_original_span(&original, tr(1u32, 2u32));
    let (got_range, got_fidelity) = virtual_to_original_span(&decoded, tr(1u32, 2u32));
    if range_pos(got_range) != range_pos(want_range) { panic(3); };
    if range_end(got_range) != range_end(want_range) { panic(4); };
    if !fidelity_eq(got_fidelity, want_fidelity) { panic(5); };
    let (want2, f2) = virtual_to_original_span(&original, tr(16u32, 20u32));
    let (got2, g2) = virtual_to_original_span(&decoded, tr(16u32, 20u32));
    if range_pos(got2) != range_pos(want2) || range_end(got2) != range_end(want2) { panic(6); };
    if !fidelity_eq(g2, f2) { panic(7); };
}

// spanmap_test.go:594 (byte-level contract; text is given as bytes, DEV-003)
@test "validate"() {
    let virtual_ = bytes3(97u8, 98u8, 99u8);
    let original = bytes5(120u8, 97u8, 98u8, 99u8, 121u8);

    let good = new(&seeds1(segment(0u32, 3u32, 1u32, 4u32, Kind::verbatim(), Feature::none())));
    let (err1, bad1) = validate(&good, &virtual_, &original);
    if bad1 == true { panic(1); };

    let mismatch = new(&seeds1(segment(0u32, 3u32, 0u32, 3u32, Kind::verbatim(), Feature::none())));
    let (err2, bad2) = validate(&mismatch, &virtual_, &original);
    if bad2 == false { panic(2); };
    if !error_kind_eq(err2.kind, MappingErrorKind::VerbatimMismatch) { panic(3); };

    let overlap = new(&seeds2(
        segment(0u32, 2u32, 0u32, 2u32, Kind::atom(), Feature::none()),
        segment(1u32, 3u32, 2u32, 4u32, Kind::atom(), Feature::none()),
    ));
    let (err3, bad3) = validate(&overlap, &virtual_, &original);
    if bad3 == false { panic(4); };
    if !error_kind_eq(err3.kind, MappingErrorKind::Overlap) { panic(5); };

    let oob = new(&seeds1(segment(0u32, 3u32, 3u32, 9u32, Kind::atom(), Feature::none())));
    let (err4, bad4) = validate(&oob, &virtual_, &original);
    if bad4 == false { panic(6); };
    if !error_kind_eq(err4.kind, MappingErrorKind::OutOfBounds) { panic(7); };

    let bad_kind = new(&seeds1(segment(0u32, 3u32, 1u32, 4u32, kind_from_code(9i32), Feature::none())));
    let (err5, bad5) = validate(&bad_kind, &virtual_, &original);
    if bad5 == false { panic(8); };
    if !error_kind_eq(err5.kind, MappingErrorKind::Kind_) { panic(9); };

    let bad_feature = new(&seeds1(segment(0u32, 3u32, 1u32, 4u32, Kind::atom(), feature_from_bits(1048576u32))));
    let (err6, bad6) = validate(&bad_feature, &virtual_, &original);
    if bad6 == false { panic(10); };
    if !error_kind_eq(err6.kind, MappingErrorKind::Feature) { panic(11); };
}
