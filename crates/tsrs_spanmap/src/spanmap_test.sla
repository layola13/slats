// PORT-MIRROR: crates/tsrs_spanmap/src/spanmap_test.rs
// UPSTREAM-LINES: 738
// PORT-STATUS: partial (ported tests below; the remaining upstream tests are listed in PORT_STATUS.md)
//
// spanmap/spanmap_test.go. Go's subtests run as loops; BenchmarkOriginalToVirtualPositionNearEnd is a
// benchmark, not a test, and is not ported.
//
// SLA has no `#[test]` attribute or slices, so tests are `@test "name"() { }` blocks and segment lists are
// built with the `segs1..segs4` helpers. Rust's `assert_eq!` becomes `if got != want { panic(code) }`.

@import "spanmap.sla"

fn seeds1(a: Segment) -> Vec<Segment> {
    let v: Vec<Segment> = Vec::new();
    v.push(a);
    return v;
}

fn seeds2(a: Segment, b: Segment) -> Vec<Segment> {
    let v: Vec<Segment> = Vec::new();
    v.push(a);
    v.push(b);
    return v;
}

fn seeds3(a: Segment, b: Segment, c: Segment) -> Vec<Segment> {
    let v: Vec<Segment> = Vec::new();
    v.push(a);
    v.push(b);
    v.push(c);
    return v;
}

fn tr(a: u32, b: u32) -> TextRange {
    return new_text_range(a, b);
}

fn range_pos(r: TextRange) -> u32 {
    let p = r.pos();
    let (v, _ok) = p.source_offset();
    return v;
}

fn range_end(r: TextRange) -> u32 {
    let e = r.end();
    let (v, _ok) = e.source_offset();
    return v;
}

fn bytes3(a: u8, b: u8, c: u8) -> Vec<u8> {
    let v: Vec<u8> = Vec::new();
    v.push(a);
    v.push(b);
    v.push(c);
    return v;
}

fn bytes5(a: u8, b: u8, c: u8, d: u8, e: u8) -> Vec<u8> {
    let v: Vec<u8> = Vec::new();
    v.push(a);
    v.push(b);
    v.push(c);
    v.push(d);
    v.push(e);
    return v;
}

// spanmap_test.go:11
@test "virtual_to_original_span_verbatim"() {
    let m = new(&seeds1(segment(0u32, 10u32, 100u32, 110u32, Kind::verbatim(), Feature::all())));
    let (got, fid) = virtual_to_original_span(&m, tr(2u32, 5u32));
    if range_pos(got) != 102u32 { panic(1); };
    if range_end(got) != 105u32 { panic(2); };
    if !fidelity_eq(fid, Fidelity::Exact) { panic(3); };
}

// spanmap_test.go:40
@test "virtual_to_original_span_atom"() {
    let m = new(&seeds1(segment(3u32, 14u32, 60u32, 71u32, Kind::atom(), Feature::all())));
    let (got, fid) = virtual_to_original_span(&m, tr(3u32, 14u32));
    if range_pos(got) != 60u32 { panic(1); };
    if range_end(got) != 71u32 { panic(2); };
    if !fidelity_eq(fid, Fidelity::Atom) { panic(3); };
}

// spanmap_test.go:53
@test "virtual_alias"() {
    let m = new(&seeds1(segment(3u32, 6u32, 10u32, 11u32, Kind::alias(), Feature::all())));
    let (got, fid) = virtual_to_original_span(&m, tr(3u32, 6u32));
    if range_pos(got) != 10u32 { panic(1); };
    if range_end(got) != 11u32 { panic(2); };
    if !fidelity_eq(fid, Fidelity::Atom) { panic(3); };
    let (alias, ok) = alias_for_virtual_span(&m, tr(3u32, 6u32));
    if ok == false { panic(4); };
    if !segment_eq(alias, segment(3u32, 6u32, 10u32, 11u32, Kind::alias(), Feature::all())) { panic(5); };
}

// spanmap_test.go:72
@test "virtual_to_original_span_synthesized_gap"() {
    let m = new(&seeds2(
        segment(0u32, 10u32, 100u32, 110u32, Kind::verbatim(), Feature::all()),
        segment(20u32, 30u32, 200u32, 210u32, Kind::verbatim(), Feature::all()),
    ));
    let (got, fid) = virtual_to_original_span(&m, tr(12u32, 15u32));
    if range_pos(got) != 110u32 { panic(1); };
    if range_end(got) != 110u32 { panic(2); };
    if !fidelity_eq(fid, Fidelity::None_) { panic(3); };
}

