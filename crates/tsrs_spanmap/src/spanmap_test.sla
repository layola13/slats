// spanmap_test.go:142
@test "virtual_to_original_position"() {
    let m = new(&seeds2(
        segment(0u32, 10u32, 100u32, 110u32, Kind::verbatim(), Feature::all()),
        segment(20u32, 30u32, 200u32, 210u32, Kind::verbatim(), Feature::all()),
    ));
    let (p, f1) = virtual_to_original_position(&m, 4u32);
    if p != 104u32 || !fidelity_eq(f1, Fidelity::Exact) { panic(1); };
    let (g, f2) = virtual_to_original_position(&m, 12u32);
    if g != 110u32 || !fidelity_eq(f2, Fidelity::None_) { panic(2); };
    let (h, f3) = virtual_to_original_position(&m, 20u32);
    if h != 200u32 || !fidelity_eq(f3, Fidelity::Exact) { panic(3); };
}

// spanmap_test.go:191
@test "virtual_to_original_position_exact_rejects_discontinuous_boundary"() {
    let m = new(&seeds2(
        segment(0u32, 5u32, 100u32, 105u32, Kind::verbatim(), Feature::all()),
        segment(5u32, 10u32, 200u32, 205u32, Kind::verbatim(), Feature::all()),
    ));
    let (mapped, ok) = virtual_to_original_position_exact(&m, 5u32);
    if ok == true { panic(1); };
    if mapped != 200u32 { panic(2); };
    let (mid, ok2) = virtual_to_original_position_exact(&m, 7u32);
    if ok2 == false { panic(3); };
    if mid != 202u32 { panic(4); };
}

// spanmap_test.go:204
@test "zero_length_spans_at_segment_ends"() {
    let m = new(&seeds2(
        segment(0u32, 10u32, 100u32, 110u32, Kind::verbatim(), Feature::all()),
        segment(10u32, 20u32, 120u32, 130u32, Kind::verbatim(), Feature::all()),
    ));
    let (a, fa) = virtual_to_original_span(&m, tr(10u32, 10u32));
    let (b, fb) = virtual_to_original_span(&m, tr(20u32, 20u32));
    if range_pos(a) != 120u32 || range_end(a) != 120u32 { panic(1); };
    if range_pos(b) != 130u32 || range_end(b) != 130u32 { panic(2); };
    if !fidelity_eq(fa, Fidelity::Exact) || !fidelity_eq(fb, Fidelity::Exact) { panic(3); };
}

// spanmap_test.go:243
@test "original_to_virtual_span_verbatim"() {
    let m = new(&seeds1(segment(0u32, 10u32, 100u32, 110u32, Kind::verbatim(), Feature::all())));
    let got = original_to_virtual_spans(&m, tr(102u32, 105u32), Feature::all());
    if len(&got) != 1 { panic(1); };
    if range_pos(got[0].span) != 2u32 || range_end(got[0].span) != 5u32 { panic(2); };
    if !fidelity_eq(got[0].fidelity, Fidelity::Exact) { panic(3); };
}

