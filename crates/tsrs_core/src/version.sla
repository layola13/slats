// PORT-MIRROR: crates/tsrs_core/src/version.rs
// UPSTREAM-LINES: 34
// PORT-STATUS: ported
// ITEMS: fn version, fn version_major_minor
//
// DEV-007: VERSION is a compile-time constant, so both accessors return constants. The dot-scan used
// by VERSION_MAJOR_MINOR is still ported verbatim as `major_minor_of` over bytes, because Rust `&str`
// byte access is miscompiled in SLA (DEV-003); it is the tested reference for the folded constants.
// Rust panics on a version without a second dot; a non-void function cannot panic in SLA, so invalid
// input returns an empty vector (the compile-time VERSION always has a second dot).

fn version() -> String {
    return format("{}", "7.1.0-dev");
}

fn major_minor_of(text: &Vec<u8>) -> Vec<u8> {
    let out: Vec<u8> = Vec::new();
    let i = 0usize;
    let seen_major = false;
    while i < len(text) {
        if text[i] == 46u8 {
            if seen_major {
                return out;
            };
            seen_major = true;
        };
        out.push(text[i]);
        i = i + 1;
    }
    let bad: Vec<u8> = Vec::new();
    return bad;
}

fn version_major_minor() -> String {
    return format("{}", "7.1");
}
