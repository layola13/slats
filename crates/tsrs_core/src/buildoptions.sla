// PORT-MIRROR: crates/tsrs_core/src/buildoptions.rs
// UPSTREAM-LINES: 16
// PORT-STATUS: ported
// ITEMS: struct BuildOptions
//
// LIM-002: `Option<i64> builders` is represented as the `(i64, bool)` pair `builders`/`has_builders`,
// because Option return values trap the SLA backend.

@import "tristate.sla"

@derive(Copy)
struct BuildOptions {
    dry: Tristate,
    force: Tristate,
    verbose: Tristate,
    builders: i64,
    has_builders: bool,
    stop_build_on_errors: Tristate,
    clean: Tristate,
}

fn build_options_default() -> BuildOptions {
    return BuildOptions {
        dry: tristate_unknown(),
        force: tristate_unknown(),
        verbose: tristate_unknown(),
        builders: 0,
        has_builders: false,
        stop_build_on_errors: tristate_unknown(),
        clean: tristate_unknown(),
    };
}
