// LIM-009: fieldless Rust enum -> `@derive(Copy)` struct with the same u32 representation.

@derive(Copy)
struct LanguageVariant { code: u32 }

fn language_variant_standard() -> LanguageVariant { return LanguageVariant { code: 0u32 }; }
fn language_variant_jsx() -> LanguageVariant { return LanguageVariant { code: 1u32 }; }

impl LanguageVariant {
    fn string(self) -> String {
        if self.code == 0u32 { return format("{}", "LanguageVariantStandard"); };
        return format("{}", "LanguageVariantJSX");
    }

    fn format(self) -> String {
        return self.string();
    }
}
