// PORT-MIRROR: crates/tsrs_core/src/scriptkind.rs
// UPSTREAM-LINES: 45
// PORT-STATUS: ported
// ITEMS: type ScriptKind, fn string, fn format
//
// LIM-009: fieldless Rust enum with explicit discriminants -> `@derive(Copy)` struct holding the same
// i32 representation; constructors keep the Rust variant names available through free functions.

@derive(Copy)
struct ScriptKind { code: i32 }

fn script_kind_unknown() -> ScriptKind { return ScriptKind { code: 0 }; }
fn script_kind_js() -> ScriptKind { return ScriptKind { code: 1 }; }
fn script_kind_jsx() -> ScriptKind { return ScriptKind { code: 2 }; }
fn script_kind_ts() -> ScriptKind { return ScriptKind { code: 3 }; }
fn script_kind_tsx() -> ScriptKind { return ScriptKind { code: 4 }; }
fn script_kind_json() -> ScriptKind { return ScriptKind { code: 6 }; }

impl ScriptKind {
    fn string(self) -> String {
        if self.code == 0 { return format("{}", "ScriptKindUnknown"); };
        if self.code == 1 { return format("{}", "ScriptKindJS"); };
        if self.code == 2 { return format("{}", "ScriptKindJSX"); };
        if self.code == 3 { return format("{}", "ScriptKindTS"); };
        if self.code == 4 { return format("{}", "ScriptKindTSX"); };
        return format("{}", "ScriptKindJSON");
    }

    fn format(self) -> String {
        return self.string();
    }
}
